# ---------------------------------------------------------------------------
# Catalog source
# ---------------------------------------------------------------------------
# mock     (default) in-memory fixtures; no other variable is needed
# shopify  live Storefront API; requires the SHOPIFY_* variables below
CATALOG_SOURCE=mock

# Required only when CATALOG_SOURCE=shopify
# Your permanent store domain, not a custom domain:
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API access token. Needs unauthenticated_read_product_listings.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_STOREFRONT_TOKEN=
# Optional. Shopify ships a version quarterly and supports each for a year --
# check https://shopify.dev/docs/api/usage/versioning before pinning.
# SHOPIFY_API_VERSION=2026-07
# Optional. Per-request timeout in milliseconds, default 8000.
# SHOPIFY_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Signing key for the cart cookie. Optional in development (falls back to a
# hardcoded value); REQUIRED in production -- the server refuses to boot without
# it, since this repo is public and so is the fallback.
# Generate one with: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=
